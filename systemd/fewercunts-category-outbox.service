[Unit]
Description=fewerCunts loopback category review receiver
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/x0ar/Worktrees/ntforum-publisher/scripts/category_outbox_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/x0ar/.local/state
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=default.target
